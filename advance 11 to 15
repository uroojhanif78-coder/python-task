        "# Task 11\n",
        "# Personal Expense Tracker\n",
        "\n",
        "expenses = []\n",
        "\n",
        "total_expenses = int(input(\"Enter total number of expenses: \"))\n",
        "\n",
        "for i in range(total_expenses):\n",
        "    print(\"\\nExpense\", i + 1)\n",
        "\n",
        "    name = input(\"Enter expense name: \")\n",
        "    category = input(\"Enter category (Food/Transport/Shopping/Bills/Other): \")\n",
        "    amount = float(input(\"Enter amount: \"))\n",
        "\n",
        "    expense = {\n",
        "        \"name\": name,\n",
        "        \"category\": category,\n",
        "        \"amount\": amount\n",
        "    }\n",
        "\n",
        "    expenses.append(expense)\n",
        "\n",
        "budget = float(input(\"\\nEnter your budget: \"))\n",
        "\n",
        "\n",
        "def report():\n",
        "    total = 0\n",
        "\n",
        "    print(\"\\n----- Expense Report -----\")\n",
        "\n",
        "    for expense in expenses:\n",
        "        total = total + expense[\"amount\"]\n",
        "\n",
        "    print(\"Total Spending:\", total)\n",
        "\n",
        "    print(\"\\nCategory Spending:\")\n",
        "\n",
        "    categories = [\"Food\", \"Transport\", \"Shopping\", \"Bills\", \"Other\"]\n",
        "\n",
        "    for category in categories:\n",
        "        category_total = 0\n",
        "\n",
        "        for expense in expenses:\n",
        "            if expense[\"category\"].lower() == category.lower():\n",
        "                category_total = category_total + expense[\"amount\"]\n",
        "\n",
        "        print(category, \":\", category_total)\n",
        "\n",
        "    highest = expenses[0]\n",
        "\n",
        "    for expense in expenses:\n",
        "        if expense[\"amount\"] > highest[\"amount\"]:\n",
        "            highest = expense\n",
        "\n",
        "    print(\"\\nHighest Expense:\")\n",
        "    print(highest[\"name\"], \"-\", highest[\"amount\"])\n",
        "\n",
        "    if total > budget:\n",
        "        print(\"\\nWARNING: Budget Exceeded!\")\n",
        "    else:\n",
        "        print(\"\\nBudget is within limit.\")\n",
        "\n",
        "\n",
        "report()"
