        "#  task 15\n",
        "#Clinic Patient Management System\n",
        "\n",
        "patients = []\n",
        "\n",
        "\n",
        "def add_appointment():\n",
        "    patient_id = input(\"Enter Patient ID: \")\n",
        "\n",
        "    for patient in patients:\n",
        "        if patient[\"id\"] == patient_id:\n",
        "            print(\"Patient ID already exists!\")\n",
        "            return\n",
        "\n",
        "    name = input(\"Enter Patient Name: \")\n",
        "    age = int(input(\"Enter Age: \"))\n",
        "    disease = input(\"Enter Disease/Problem: \")\n",
        "    time = input(\"Enter Appointment Time: \")\n",
        "    emergency = input(\"Emergency? (yes/no): \")\n",
        "\n",
        "    patient = {\n",
        "        \"id\": patient_id,\n",
        "        \"name\": name,\n",
        "        \"age\": age,\n",
        "        \"disease\": disease,\n",
        "        \"time\": time,\n",
        "        \"emergency\": emergency\n",
        "    }\n",
        "\n",
        "    patients.append(patient)\n",
        "\n",
        "    print(\"Appointment added!\")\n",
        "\n",
        "\n",
        "def search_patient():\n",
        "    patient_id = input(\"Enter Patient ID: \")\n",
        "\n",
        "    for patient in patients:\n",
        "        if patient[\"id\"] == patient_id:\n",
        "            print(\"\\nPatient Found!\")\n",
        "            print(patient)\n",
        "            return\n",
        "\n",
        "    print(\"Patient not found!\")\n",
        "\n",
        "\n",
        "def display_appointments():\n",
        "    print(\"\\n--- Appointments ---\")\n",
        "\n",
        "    for patient in patients:\n",
        "        print(patient[\"id\"], patient[\"name\"], patient[\"time\"])\n",
        "\n",
        "\n",
        "def cancel_appointment():\n",
        "    patient_id = input(\"Enter Patient ID: \")\n",
        "\n",
        "    for patient in patients:\n",
        "        if patient[\"id\"] == patient_id:\n",
        "            patients.remove(patient)\n",
        "            print(\"Appointment cancelled!\")\n",
        "            return\n",
        "\n",
        "    print(\"Patient not found!\")\n",
        "\n",
        "\n",
        "def clinic_summary():\n",
        "    normal = 0\n",
        "    emergency = 0\n",
        "\n",
        "    print(\"\\n--- Emergency Patients ---\")\n",
        "\n",
        "    for patient in patients:\n",
        "        if patient[\"emergency\"].lower() == \"yes\":\n",
        "            print(patient[\"name\"])\n",
        "            emergency += 1\n",
        "        else:\n",
        "            normal += 1\n",
        "\n",
        "    print(\"\\nNormal Patients:\", normal)\n",
        "    print(\"Emergency Patients:\", emergency)\n",
        "    print(\"Total Patients:\", len(patients))\n",
        "\n",
        "\n",
        "while True:\n",
        "\n",
        "    print(\"\\n--- CLINIC MENU ---\")\n",
        "    print(\"1. Add Appointment\")\n",
        "    print(\"2. Search Patient\")\n",
